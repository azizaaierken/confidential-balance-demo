# Copy to console/.env and run `bun run bootstrap` — it fills in every key
# below (never commit the real file). Values are base58 of the 64-byte
# keypair form the Solana CLI writes.

# Solana JSON-RPC endpoint. On the platform a shared HELIUS_RPC_URL /
# TRITON_RPC_URL key, if attached, takes precedence over this.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Filled in by bootstrap:
# PAYER_KEYPAIR=
# MINT_AUTHORITY_KEYPAIR=
# SENDER_KEYPAIR=
# RECEIVER_KEYPAIR=
# AUDITOR_ROOT_KEYPAIR=
# MINT_ADDRESS=

# Optional, local only. Platform-injected in production by provision_database.
# DATABASE_URL=postgresql://postgres:dev@localhost:5432/postgres
