# Environment variables the Rust service reads. It does not load a .env file
# itself — export these in your shell, or run it with a tool such as
# `env $(cat .env | xargs) cargo run --bin server`.

# HTTP port the API listens on.
PORT=8787

# Solana JSON-RPC endpoint. The public devnet endpoint is rate-limited; a
# dedicated devnet URL from an RPC provider is noticeably smoother.
SOLANA_RPC_URL=https://api.devnet.solana.com

# Where the demo's Ed25519 keypair files live (payer, mint, personas, auditor
# generations). Relative paths resolve against the working directory.
RUST_SERVICE_KEYS_DIR=keys

# Where the local activity, disclosure and auditor-generation logs live.
RUST_SERVICE_DATA_DIR=data

# Passwords for the three demo roles. These defaults are printed to the log
# at startup; override them for anything beyond a local demo.
OWNER_SENDER_PASSWORD=sender-demo
OWNER_RECEIVER_PASSWORD=receiver-demo
AUDITOR_PASSWORD=auditor-demo

# Only for devnet accounts provisioned before solana-zk-sdk's HKDF key
# derivation migration. A fresh clone should leave this unset — see
# rust-service/src/keys.rs.
# LEGACY_KDF=1

# Log filter (tracing-subscriber EnvFilter syntax).
RUST_LOG=info
